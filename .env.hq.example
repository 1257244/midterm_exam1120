# ===== 總部機（老闆機）設定 =====
# 用法：cp .env.hq.example .env

# 這台只跑「閘道 + 總部」（請勿修改）
COMPOSE_FILE=docker-compose.yml:docker-compose.hq.yml

# Docker Hub 帳號（映像檔會是 <帳號>/drink-hq）
DOCKERHUB_USER=alexliu0814
TAG=latest

BRAND_NAME=開心飲品

# 總部與分店之間溝通用的金鑰：請改成一串亂數，並把同一串填到每台分店機的 .env
HQ_API_KEY=change-me-api-key
SECRET_KEY=change-me-hq-secret

# 老闆帳號（總部後台 /admin）
ADMIN_USER=boss
ADMIN_PASSWORD=boss1234
