# ===== 分店機設定 =====
# 用法：cp .env.store.example .env，再把下面兩個 IP 改成實際的位址

# 這台只跑「閘道 + stores.csv 裡的分店」（請勿修改）
COMPOSE_FILE=docker-compose.yml:docker-compose.stores.yml

# ★ 總部機的網址（分店會向這裡報到、取共用菜單、回報訂單）—— 改成總部機的 IP
HQ_URL=http://192.168.1.10

# ★ 這台分店機自己的網址（總部官網的「門市據點」會連到這裡）—— 改成本機 IP，結尾不要加 /
STORE_BASE_URL=http://192.168.1.20

# 必須和總部機 .env 的 HQ_API_KEY 一模一樣，否則總部會拒絕分店報到
HQ_API_KEY=change-me-api-key
SECRET_KEY=change-me-store-secret

# Docker Hub 帳號（映像檔會是 <帳號>/drink-store）
DOCKERHUB_USER=alexliu0814
TAG=latest

BRAND_NAME=開心飲品

# 分店店長密碼預設寫在 stores.csv；若要覆蓋，可在這裡設定 STORE_PASSWORD_<分店代號大寫>
# STORE_PASSWORD_TAIPEI=my-secret
