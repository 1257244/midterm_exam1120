# 複製成 .env 後修改：cp .env.example .env

# 讓 docker compose 同時讀取「核心服務」與「分店」兩個設定檔（請勿修改）
COMPOSE_FILE=docker-compose.yml:docker-compose.stores.yml

# 你的 Docker Hub 帳號（映像檔會是 <帳號>/drink-hq、<帳號>/drink-store）
DOCKERHUB_USER=your-dockerhub-account
TAG=latest

BRAND_NAME=開心飲品

# 總部與分店之間溝通用的金鑰（請改成一串亂數）
HQ_API_KEY=change-me-api-key
SECRET_KEY=change-me-secret

# 老闆帳號（總部後台）
ADMIN_USER=boss
ADMIN_PASSWORD=boss1234

# 分店店長密碼預設寫在 stores.csv；若要覆蓋，可在這裡設定 STORE_PASSWORD_<分店代號大寫>
# STORE_PASSWORD_TAIPEI=my-secret
